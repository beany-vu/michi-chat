{
  "name": "michi-chat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "drizzle-kit migrate && next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/prompt.test.ts src/lib/tenant.test.ts src/lib/tools/tools.test.ts src/lib/rag/chunk.test.ts src/lib/slack.test.ts",
    "test:isolation": "tsx --test src/db/isolation.test.ts",
    "kb:ingest": "tsx scripts/kb-ingest.ts",
