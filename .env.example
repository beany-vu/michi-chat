# Per-machine settings. Copy to .env, which is gitignored.

# This WSL distro's own eth0 IP (`ip addr show eth0`), NOT host.docker.internal, which
# reaches Windows rather than this distro. It changes after a WSL restart.
MICHI_OLLAMA_HOST=<e.g. 192.168.x.x>

MICHI_CHAT_PORT=3001
MICHI_CHAT_DB_PORT=5435
MICHI_CHAT_LITELLM_PORT=4000

# Shared between the app and the LiteLLM proxy. Fine to leave as the default locally;
# must be replaced before this is exposed anywhere.
MICHI_CHAT_LITELLM_KEY=sk-michi-dev

# Password for /admin. There is no users table: one operator, one password, hashed with
# scrypt at compare time.
MICHI_ADMIN_PASSWORD=change-me

# Which tenant slug the root path redirects to.
MICHI_DEFAULT_TENANT=mugshot
