# Copy to .env and fill in. The two required values have no defaults on purpose.

# Admin login for http://localhost:3001/admin  (required)
MICHI_ADMIN_PASSWORD=

# Shared key between the app and the bundled LiteLLM proxy. Any long random string.  (required)
MICHI_CHAT_LITELLM_KEY=

# Password for the bundled Postgres. Any random string; only reachable inside the
# compose network.  (required)
MICHI_DB_PASSWORD=

# Host port for the app (browser goes to http://localhost:3001)
MICHI_PORT=3001

# --- Model backend: pick ONE path and see litellm.config.yaml -----------------------

# Path A (default): Ollama running on this machine, with these models pulled:
#   ollama pull qwen3.5:4b && ollama pull qwen2.5:7b && ollama pull nomic-embed-text
# host.docker.internal works on Docker Desktop and, via extra_hosts, on Linux.
OLLAMA_API_BASE=http://host.docker.internal:11434

# Path B: a hosted provider. Uncomment your key and repoint the aliases in
# litellm.config.yaml. No app changes needed.
# OPENAI_API_KEY=
# DASHSCOPE_API_KEY=

# Advanced: run a locally built image instead of the published one.
# MICHI_IMAGE=michi-chat:local
